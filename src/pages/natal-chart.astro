---
import Base from '../layouts/Base.astro';
import BirthForm from '../components/BirthForm.astro';
---
<Base
  title="Natal chart"
  description="Draw a natal chart from your date, time and place of birth, calculated with the Swiss Ephemeris from NASA JPL's DE441 data."
>
  <div class="page natal">
    <div class="container">
      <header class="page-header">
        <h1>Natal chart</h1>
        <p>
          Enter when and where you were born. Positions are calculated for that exact place on
          Earth with the Swiss Ephemeris, from NASA JPL’s DE441 planetary data.
        </p>
      </header>

      <BirthForm id="natal-form" submitLabel="Draw my chart" />

      <section class="natal-result" id="natal-result" hidden aria-labelledby="natal-result-title">
        <h2 id="natal-result-title" class="natal-result-title"></h2>
        <p class="natal-result-utc" id="natal-result-utc"></p>
        <p class="natal-result-meta" id="natal-result-meta"></p>
        <div class="natal-layout">
          <div class="natal-wheel" id="natal-wheel" aria-hidden="true"></div>
          <table class="natal-table" id="natal-table">
            <caption class="sr-only">Planetary positions</caption>
            <thead><tr><th scope="col">Body</th><th scope="col">Position</th><th scope="col">House</th><th scope="col"><abbr title="whole-sign">WS</abbr></th></tr></thead>
            <tbody id="natal-rows"></tbody>
          </table>
        </div>

        <section class="natal-spread" aria-labelledby="natal-spread-title">
          <h3 id="natal-spread-title">Your Symbolon spread</h3>
          <p class="natal-spread-intro">
            The cards your Ascendant and personal planets cast: the Sun takes the card of its
            sign, and each other planet the card joining the sign it rules with the one it
            stands in.
          </p>
          <div class="natal-spread-fan" id="natal-spread-fan"></div>
          <table class="natal-spread-table">
            <caption class="sr-only">The cards of your Symbolon spread</caption>
            <thead><tr><th scope="col">Placement</th><th scope="col">Card</th><th scope="col">Reading</th></tr></thead>
            <tbody id="natal-spread-rows"></tbody>
          </table>
        </section>

        <section class="natal-hellenistic" aria-labelledby="natal-hellenistic-title">
          <h3 id="natal-hellenistic-title">Hellenistic reading</h3>
          <div id="natal-hellenistic"></div>
        </section>

        <p class="natal-next">
          <a id="natal-map-link" href="/astrocartography/" hidden>See your lines on the map</a>
          <a class="btn btn-primary" href="/#ask" data-track="click/start-conversation-natal">Start a conversation</a>
        </p>
      </section>

      <p class="natal-credit">
        Place names © <a href="https://www.geonames.org/">GeoNames</a>, CC BY 4.0. Chart drawn with{' '}
        <a href="https://github.com/AstroDraw/AstroChart">AstroChart</a>. Positions from the Swiss
        Ephemeris, calculated in your browser with{' '}
        <a href="https://github.com/swisseph-js/swisseph">swisseph-js</a>, open source under the AGPL.
      </p>
    </div>
  </div>
</Base>

<script>
  import { Chart, AspectCalculator } from '@astrodraw/astrochart';
  import { initBirthForm, placeName, coords, track } from '../lib/birth-form';
  import { wsHouse } from '../lib/hellenistic';
  import { birthQuery } from '../lib/birth-query';
  import type { Positions } from '../lib/ephemeris';

  // the ephemeris's bodies, as AstroChart names and draws them
  const BODIES: [api: string, chart: string, label: string][] = [
    ['sun', 'Sun', 'Sun'], ['moon', 'Moon', 'Moon'], ['mercury', 'Mercury', 'Mercury'],
    ['venus', 'Venus', 'Venus'], ['mars', 'Mars', 'Mars'], ['jupiter', 'Jupiter', 'Jupiter'],
    ['saturn', 'Saturn', 'Saturn'], ['uranus', 'Uranus', 'Uranus'], ['neptune', 'Neptune', 'Neptune'],
    ['pluto', 'Pluto', 'Pluto'], ['true_node', 'NNode', 'North Node'], ['mean_lilith', 'Lilith', 'Lilith'],
    ['chiron', 'Chiron', 'Chiron'],
  ];

  // ---- the chart

  const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  function houseOf(lon: number, cusps: number[]) {
    for (let i = 0; i < 12; i++) {
      const from = cusps[i], to = cusps[(i + 1) % 12];
      const span = (to - from + 360) % 360;
      if ((lon - from + 360) % 360 < span) return i + 1;
    }
    return 1;
  }

  // with no birth time there are no houses: the wheel keeps equal 30° sections
  // from 0° Aries to hold its shape, and CSS hides their lines and the axes
  const NATURAL_CUSPS = Array.from({ length: 12 }, (_, i) => i * 30);

  function drawWheel(el: HTMLElement, data: Positions) {
    el.replaceChildren();
    const size = Math.round(Math.min(el.clientWidth, 560));
    const ink = token('--ink'), faint = token('--ink-faint'), gold = token('--gold');
    const planets: Record<string, number[]> = {};
    for (const b of data.bodies) {
      const chart = BODIES.find(([api]) => api === b.name)?.[1];
      if (chart) planets[chart] = [b.longitude, b.speed_longitude];   // a negative speed marks it retrograde
    }
    // elements in the brand palette: fire maroon, earth slate, air gold, water teal
    const elements = ['#800000', '#5D6560', '#B8892B', '#006B7F'];
    const chart = new Chart(el.id, size, size, {
      COLOR_BACKGROUND: 'transparent',
      MARGIN: size < 420 ? 28 : 50,
      POINTS_COLOR: ink, SIGNS_COLOR: '#F5F1E9', CIRCLE_COLOR: faint, LINE_COLOR: faint,
      CUSPS_FONT_COLOR: faint, SYMBOL_AXIS_FONT_COLOR: gold,
      COLORS_SIGNS: Array.from({ length: 12 }, (_, i) => elements[i % 4]),
    });
    // the radix builds its aspect calculator without the settings, so the
    // brand colours are applied by calculating the aspects here
    const ASPECTS = {
      conjunction: { degree: 0, orbit: 10, color: 'transparent' },
      square: { degree: 90, orbit: 8, color: '#800000' },
      trine: { degree: 120, orbit: 8, color: '#006B7F' },
      opposition: { degree: 180, orbit: 10, color: gold },
    };
    el.classList.toggle('no-houses', !data.houses);
    const radix = chart.radix({ planets, cusps: data.houses?.cusps ?? NATURAL_CUSPS });
    radix.aspects(new AspectCalculator(radix.toPoints, { ASPECTS }).radix(planets));
  }

  function fillTable(tbody: HTMLElement, data: Positions) {
    const zodiacal = (lon: number) => {
      const signs = ['Aries', 'Taurus', 'Gemini', 'Cancer', 'Leo', 'Virgo', 'Libra', 'Scorpio',
        'Sagittarius', 'Capricorn', 'Aquarius', 'Pisces'];
      const d = lon % 30, deg = Math.floor(d), min = Math.floor((d - deg) * 60);
      return `${deg}°${String(min).padStart(2, '0')}′ ${signs[Math.floor(lon / 30) % 12]}`;
    };
    const row = (label: string, position: string, house: string, ws: string, retro = false) => {
      const tr = document.createElement('tr');
      const th = document.createElement('th');
      th.scope = 'row';
      th.textContent = label;
      const pos = document.createElement('td');
      pos.textContent = position;
      if (retro) {
        const r = document.createElement('abbr');
        r.title = 'retrograde';
        r.className = 'retro';
        r.textContent = ' R';
        pos.append(r);
      }
      const h = document.createElement('td');
      h.textContent = house;
      const w = document.createElement('td');
      w.textContent = ws;
      tr.append(th, pos, h, w);
      return tr;
    };
    const h = data.houses;
    const ws = (lon: number) => (h ? String(wsHouse(lon, h.ascendant)) : '');
    const rows = data.bodies.map((b) => {
      const label = BODIES.find(([api]) => api === b.name)?.[2] ?? b.name;
      // the formatted string carries seconds; minutes are plenty in a table
      return row(label, zodiacal(b.longitude), h ? String(houseOf(b.longitude, h.cusps)) : '', ws(b.longitude), b.retrograde);
    });
    if (h) rows.push(row('Ascendant', zodiacal(h.ascendant), '1', '1'), row('Midheaven', zodiacal(h.mc), '10', ws(h.mc)));
    tbody.replaceChildren(...rows);
    tbody.closest('table')?.classList.toggle('no-houses', !h);
  }

  // ---- the Symbolon spread

  async function drawCards(data: Positions) {
    const { castSpread, drawSpread, haveImages } = await import('../lib/symbolon');
    const slots = castSpread(data);
    document.getElementById('natal-spread-fan')!.replaceChildren(drawSpread(slots, await haveImages()));
    document.getElementById('natal-spread-rows')!.replaceChildren(...slots.flatMap((s) => s.cards.map((c, i) => {
      const tr = document.createElement('tr');
      // a slot casting two cards takes two rows under one placement
      if (i === 0) {
        const where = document.createElement('th');
        where.scope = 'row';
        where.rowSpan = s.cards.length;
        where.textContent = `${s.body} in ${s.sign}`;
        tr.append(where);
      } else tr.className = 'spread-row-more';
      const card = document.createElement('td');
      card.className = 'spread-card';
      const n = document.createElement('span');
      n.className = 'spread-card-n';
      n.textContent = String(c.n);
      const quote = document.createElement('q');
      quote.textContent = c.quote;
      card.append(n, c.name, quote);
      const reading = document.createElement('td');
      reading.className = 'spread-reading';
      const text = (tag: string, cls: string, words: string) => {
        const e = document.createElement(tag);
        e.className = cls;
        e.textContent = words;
        return e;
      };
      reading.append(
        text('p', 'spread-description', c.description),
        text('p', 'spread-motifs', c.motifs.join(' · ')),
        text('p', 'spread-imagery', `${c.imagery} ${c.symbols.join('; ')}.`),
      );
      tr.append(card, reading);
      return tr;
    })));
  }

  // ---- the page

  function initNatal() {
    const form = document.getElementById('natal-form') as HTMLFormElement | null;
    if (!form) return;
    const result = document.getElementById('natal-result')!;
    const wheel = document.getElementById('natal-wheel')!;
    let last: Positions | null = null;

    initBirthForm(form, async (b) => {
      const { computeChart } = await import('../lib/ephemeris');
      last = await computeChart({
        datetime: `${b.date}T${b.time ?? '12:00'}`, tz: b.place.time_zone,
        lat: b.place.latitude, lon: b.place.longitude,
        bodies: BODIES.map(([api]) => api), houses: b.time ? 'placidus' : 'none',
      });
      const born = new Date(`${b.date}T00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
      const h = last.houses;
      document.getElementById('natal-result-title')!.textContent = `Born ${born}, ${b.time ?? 'time unknown'}`;
      const utc = new Date(last.input.utc);
      const utcDate = utc.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' });
      const utcTime = utc.toLocaleTimeString('en-GB', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit' });
      document.getElementById('natal-result-utc')!.textContent =
        `In UTC: ${utcDate}, ${utcTime}. ` +
        (b.time ? `Local time was UTC${last.input.utc_offset}.`
                : `That is noon local time, which was UTC${last.input.utc_offset}.`);
      document.getElementById('natal-result-meta')!.textContent =
        `${placeName(b.place)} · ${coords(b.place)} · ` +
        (h ? `${h.system} houses${h.note ? ` (${h.note})` : ''}`
           : 'Drawn for noon. Houses and the Ascendant need a birth time, and the Moon may be up to 7° either way.');
      result.hidden = false;
      drawWheel(wheel, last);
      fillTable(document.getElementById('natal-rows')!, last);
      drawCards(last);
      const hel = document.getElementById('natal-hellenistic')!;
      try {
        const { renderHellenistic } = await import('../lib/hellenistic-view');
        renderHellenistic(hel, last, b.date, b.place.time_zone);
      } catch (e) {
        hel.replaceChildren();   // no stale reading from an earlier chart
        console.error(e);
      }
      const map = document.getElementById('natal-map-link') as HTMLAnchorElement;
      map.hidden = !b.time;
      map.href = `/astrocartography/${birthQuery(b, placeName(b.place))}`;
      track('natal-chart', { place: placeName(b.place).slice(0, 80), date: b.date });
      result.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });

    // redraw for the new colours when the theme flips, and for a new size on resize
    let resize: ReturnType<typeof setTimeout> | undefined;
    const redraw = () => { if (last && !result.hidden) drawWheel(wheel, last); };
    new MutationObserver(redraw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
    new ResizeObserver(() => { clearTimeout(resize); resize = setTimeout(redraw, 150); }).observe(wheel);
  }
  document.addEventListener('astro:page-load', initNatal);
</script>
