---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SlideDeck from '../../components/SlideDeck.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slides = entry.data.format === 'slides';
const dateIso = entry.data.date?.toISOString() ?? '';
const fmt = (d: Date) => d.toLocaleDateString('en-IE', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={entry.data.title} description={entry.data.description} jsonld="post" jsonldMeta={{ datePublished: dateIso }}>
  <article class="page">
    <div class="container">
      <header class="page-header">
        {entry.data.date && (
          <time class="apparatus" datetime={dateIso} style="display:block;margin-bottom:.9rem">{fmt(entry.data.date)}</time>
        )}
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p>{entry.data.description}</p>}
      </header>
      <div class:list={['prose post-body', { 'post-slides': slides }]} data-deck={slides ? '' : undefined}>
        <Content />
      </div>
      {slides && <SlideDeck />}
      <p style="margin-top:3rem"><a class="apparatus back-link" href="/blog/">← all writing</a></p>
    </div>
  </article>
</Base>
