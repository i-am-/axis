---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('pages');
  return all
    .filter((entry) => entry.id !== 'home' && entry.id !== 'blog')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const noindex = entry.data.sitemap !== undefined;
---
<Base title={entry.data.title} description={entry.data.description} noindex={noindex} jsonld="page">
  <article class="page">
    <div class="container">
      <header class="page-header">
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p>{entry.data.description}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>
