---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import avatar from '../assets/face-avatar2.png';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Jsonld from '../components/Jsonld.astro';
import GoatCounter from '../components/GoatCounter.astro';
import Liwan from '../components/Liwan.astro';

const SITE = 'Igniting Coach — Ilya Malyarenko';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonld?: 'home' | 'post' | 'page';
  jsonldMeta?: Record<string, string>;
}
const {
  title,
  description = "Life and career coaching by Ilya Malyarenko — 15 years in management consulting and six in biopharma, now helping people ignite their growth through life's biggest transitions.",
  noindex = false,
  jsonld = 'page',
  jsonldMeta = {},
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === SITE ? title : `${title} · ${SITE}`;

/* OG image — avatar cropped to 1200x630 */
const ogImage = await getImage({ src: avatar, width: 1200, height: 630, fit: 'cover', format: 'webp', quality: 80 });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const ogType = jsonld === 'post' ? 'article' : 'website';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- FOUC-free theme init (runs before paint). The OS colour scheme
         decides unless the visitor has clicked the toggle this session;
         that choice lives in sessionStorage and holds for every page
         until the tab is closed. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var mq = matchMedia('(prefers-color-scheme: light)');
        function stored() {
          try { return sessionStorage.getItem('theme'); } catch (e) { return null; }
        }
        // Direction B is dark-first: auto stays dark unless the OS asks for light.
        function resolve() {
          var t = stored();
          return t === 'light' || t === 'dark' ? t : (mq.matches ? 'light' : 'dark');
        }
        function apply(el, t) {
          el.setAttribute('data-bs-theme', t);
          el.setAttribute('data-theme', t); // astro-mermaid's loading skeleton
        }
        window.__theme = {
          resolve: resolve,
          apply: apply,
          set: function (t) {
            try { sessionStorage.setItem('theme', t); } catch (e) {}
            apply(root, t);
          },
        };
        apply(root, resolve());
        // Follow live OS changes while the visitor has not picked a theme.
        mq.addEventListener('change', function () {
          if (!stored()) apply(root, resolve());
        });
        // ClientRouter swaps in the next page's <html> attributes, which
        // carry no theme; stamp it on the incoming document before the swap.
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument.documentElement, resolve());
        });
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#15181A" />

    <!-- Open Graph / Twitter cards -->
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/img/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/logo-dark.svg" type="image/svg+xml" />

    <!-- Roboto Flex carries the body copy, Literata the headings — both
         are above the fold, so both are preloaded. -->
    <link rel="preload" href="/fonts/robotoflex/robotoflex-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata/literata-regular.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />
    <Jsonld kind={jsonld} meta={jsonldMeta} title={title} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <GoatCounter />
    <Liwan />
    <script>
      // Theme toggle (light ⇄ dark) + mobile nav — event delegation
      // so it survives view-transition navigations without re-binding.
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const themeBtn = target.closest('[data-theme-toggle]');
        if (themeBtn) {
          const current = document.documentElement.getAttribute('data-bs-theme') || 'light';
          (window as any).__theme.set(current === 'dark' ? 'light' : 'dark');
          return;
        }
        const navBtn = target.closest('#nav-toggle');
        if (navBtn) {
          const nav = document.getElementById('site-nav');
          const open = nav?.classList.toggle('open');
          navBtn.setAttribute('aria-expanded', String(!!open));
        }
      });
    </script>
  </body>
</html>
