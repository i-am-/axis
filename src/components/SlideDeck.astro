---
// Slide deck for posts with `format: slides`. The script regroups the
// rendered post body (marked data-deck) into slides: the content before the
// first <h2> opens the deck, each <h2> starts the next slide, and a `.viz`
// figure in a slide sits beside its text. Without JS nothing here runs and
// the post reads top to bottom. Styles: "slide decks" in global.css.
---
<script>
  const ARROW_PREV = '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>';
  const ARROW_NEXT = '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>';

  function build(deck: HTMLElement, signal: AbortSignal) {
    const groups: Element[][] = [[]];
    for (const el of [...deck.children]) {
      if (el.tagName === 'H2' && groups[groups.length - 1].length) groups.push([]);
      groups[groups.length - 1].push(el);
    }
    const total = groups.length;
    if (total < 2) return;

    const track = document.createElement('div');
    track.className = 'deck-track';
    const slides = groups.map((els, n) => {
      const slide = document.createElement('section');
      slide.className = 'slide';
      slide.setAttribute('aria-roledescription', 'slide');
      slide.setAttribute('aria-label', `${n + 1} of ${total}`);
      const text = document.createElement('div');
      text.className = 'slide-text';
      slide.append(text);
      // --i staggers the text in; --j staggers the parts of a figure
      els.forEach((el) => {
        if (el.classList.contains('viz')) {
          slide.classList.add('has-viz');
          [...el.children].forEach((part, j) => (part as HTMLElement).style.setProperty('--j', String(j)));
          slide.append(el);
        } else {
          (el as HTMLElement).style.setProperty('--i', String(text.children.length));
          text.append(el);
        }
      });
      track.append(slide);
      return slide;
    });

    const bar = document.createElement('div');
    bar.className = 'deck-bar';
    bar.innerHTML =
      `<button type="button" class="deck-btn" data-step="-1" aria-label="Previous slide">${ARROW_PREV}</button>` +
      `<div class="deck-progress">${slides.map((_, n) =>
        `<button type="button" data-to="${n}" aria-label="Slide ${n + 1}"></button>`).join('')}</div>` +
      `<span class="deck-count apparatus" aria-live="polite"></span>` +
      `<button type="button" class="deck-btn" data-step="1" aria-label="Next slide">${ARROW_NEXT}</button>`;
    const [prev, next] = bar.querySelectorAll<HTMLButtonElement>('.deck-btn');
    const marks = [...bar.querySelectorAll<HTMLButtonElement>('.deck-progress button')];
    const count = bar.querySelector('.deck-count')!;

    deck.replaceChildren(track, bar);
    deck.classList.add('is-deck');
    deck.setAttribute('role', 'region');
    deck.setAttribute('aria-roledescription', 'slide deck');
    deck.setAttribute('aria-label', document.querySelector('h1')?.textContent ?? 'Slides');

    let current = -1;
    const show = (n: number) => {
      n = Math.max(0, Math.min(total - 1, n));
      if (n === current) return;
      deck.dataset.dir = n < current ? 'back' : 'forward';
      current = n;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === n);
        slide.inert = i !== n;
      });
      marks.forEach((mark, i) => {
        mark.classList.toggle('is-done', i <= n);
        if (i === n) mark.setAttribute('aria-current', 'step');
        else mark.removeAttribute('aria-current');
      });
      count.textContent = `${n + 1} / ${total}`;
      prev.disabled = n === 0;
      next.disabled = n === total - 1;
      // a tall slide can leave the reader below the top of the next one
      if (deck.getBoundingClientRect().top < 0) {
        deck.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };
    show(0);

    bar.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!btn) return;
      if (btn.dataset.step) show(current + Number(btn.dataset.step));
      else if (btn.dataset.to) show(Number(btn.dataset.to));
    }, { signal });

    // arrow keys turn the slides while the deck is on screen
    let onScreen = false;
    const io = new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; }, { threshold: 0.35 });
    io.observe(deck);
    signal.addEventListener('abort', () => io.disconnect());
    document.addEventListener('keydown', (e) => {
      if (!onScreen || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      if ((e.target as Element).closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    }, { signal });

    // and a horizontal swipe does on touch screens
    let start: { x: number; y: number } | null = null;
    track.addEventListener('pointerdown', (e) => {
      start = e.pointerType === 'mouse' ? null : { x: e.clientX, y: e.clientY };
    }, { signal });
    track.addEventListener('pointerup', (e) => {
      if (!start) return;
      const dx = e.clientX - start.x, dy = e.clientY - start.y;
      start = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    }, { signal });
  }

  // ClientRouter swaps pages in place: build on every page load, and drop
  // the document-level listeners before the next swap
  let controller: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const deck = document.querySelector<HTMLElement>('[data-deck]');
    if (deck) build(deck, controller.signal);
  });
</script>
