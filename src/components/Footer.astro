---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <div class="footer-brand">
          <img class="logo lockup logo-light" src="/img/brand/logo-on-light.webp" alt="Igniting Coach" width="360" height="204" />
          <img class="logo lockup logo-dark" src="/img/brand/logo-on-dark.webp" alt="Igniting Coach" width="360" height="204" />
        </div>
      </div>
      <div class="footer-meta">
        <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle colour theme">◐</button>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Ilya Malyarenko</span>
    </div>
  </div>
</footer>
