---
// GoatCounter  cookieless, self-hosted at stats.igniting.coach.
// Loaded only in production builds; disable via PUBLIC_ANALYTICS_ENABLED=false.
const enabled = import.meta.env.PROD && import.meta.env.PUBLIC_ANALYTICS_ENABLED !== 'false';
const url = import.meta.env.PUBLIC_ANALYTICS_URL ?? 'https://stats.igniting.coach';
---
{enabled && (
  <>
    <script data-goatcounter={`${url}/count`} async src={`${url}/count.js`}></script>
    <script is:inline>
      /* The site navigates with Astro's ClientRouter, so count.js only ever
         sees the first hard load  every in-site page view after that goes
         unrecorded. Count the subsequent ones by hand. The first
         astro:page-load fires alongside count.js's own automatic hit, so it
         is skipped to avoid double-counting. */
      (function () {
        var first = true;
        document.addEventListener('astro:page-load', function () {
          if (first) { first = false; return; }
          if (!window.goatcounter || !window.goatcounter.count) return;
          window.goatcounter.count({
            path: location.pathname + location.search + location.hash,
            title: document.title,
            event: false,
          });
        });

        /* Events: a click on an element with data-track="name", or the
           submission of a form with it, counts as the event "name". This is
           delegated from the document, not count.js's own
           data-goatcounter-click, which binds only the elements present on
           the first load and so misses every page swapped in after it. A
           form's submit fires only once the browser has accepted its
           required fields, so it counts real submissions. */
        function track(e) {
          var el = e.target.closest && e.target.closest('[data-track]');
          if (!el || (e.type === 'click') === (el.tagName === 'FORM')) return;
          if (!window.goatcounter || !window.goatcounter.count) return;
          window.goatcounter.count({ path: el.dataset.track, title: document.title, event: true });
        }
        document.addEventListener('click', track);
        document.addEventListener('submit', track);
      })();
    </script>
  </>
)}
