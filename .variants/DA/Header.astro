---
const nav = [
  { url: '/method/', name: 'Method' },
  { url: '/domains/', name: 'Domains' },
  { url: '/resources/', name: 'Resources' },
  { url: '/blog/', name: 'Writing' },
];
const here = Astro.url.pathname;
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="Igniting Coach — home">
      <img class="logo logo-light" src="/img/logo-light.svg" alt="" width="32" height="32" />
      <img class="logo logo-dark" src="/img/logo-dark.svg" alt="" width="32" height="32" />
      <span>Igniting Coach</span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      {nav.map((item) => (
        <a
          href={item.url}
          class={here === item.url ? 'active' : undefined}
          aria-current={here === item.url ? 'page' : undefined}
        >
          {item.name}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="icon-link" href="/#contact" aria-label="Contact me">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697Zm6.761 4.08L.191 12.734A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.266l-6.57-3.956L8 9.586l-1.239-.808Zm.091 2.02 6.57 3.955L16 5.697l-7.148 5.1Z"/></svg>
      </a>
      <a class="icon-link" href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146Zm4.943 12.248V6.169H2.542v7.225h2.401Zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016Zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4Z"/></svg>
      </a>
      <a class="nav-cta" href="/#ask">Start a conversation</a>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle colour theme">◐</button>
      <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
